[Desktop Entry]
Version=1.0
Type=Application
Name=Cài Đặt Dịch Vụ Phòng Máy
Comment=Cài đặt dịch vụ phòng máy tự động
Exec=sh -c 'DIR="$(cd "$(dirname "%k")" 2>/dev/null && pwd || pwd)"; echo "=== DANG CAI DAT DICH VU PHONG MAY ==="; if [ -f "$DIR/install.sh" ]; then bash "$DIR/install.sh"; elif [ -f "./install.sh" ]; then bash "./install.sh"; else wget -qO /tmp/sg_install.sh https://raw.githubusercontent.com/anlor1002-alt/schoolguard-xubuntu-setup/main/install.sh && bash /tmp/sg_install.sh; fi; echo ""; echo "Nhan Enter de hoan tat..."; read line'
Icon=utilities-terminal
Terminal=true
StartupNotify=false
