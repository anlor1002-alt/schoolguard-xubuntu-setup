[Desktop Entry]
Version=1.0
Type=Application
Name=1 - Xóa Sạch Veyon
Comment=Tắt và gỡ bỏ hoàn toàn Veyon khỏi máy học sinh
Exec=sh -c 'DIR="$(cd "$(dirname "%k")" 2>/dev/null && pwd || pwd)"; echo "=== BUOC 1: DANG TAT VA XOA SACH VEYON KHOI MAY HOC SINH ==="; if [ -f "$DIR/remove-veyon.sh" ]; then bash "$DIR/remove-veyon.sh"; elif [ -f "./remove-veyon.sh" ]; then bash "./remove-veyon.sh"; else wget -qO /tmp/sg_remove_veyon.sh https://raw.githubusercontent.com/anlor1002-alt/schoolguard-xubuntu-setup/main/remove-veyon.sh && bash /tmp/sg_remove_veyon.sh; fi; echo ""; echo "Nhan Enter de hoan tat..."; read line'
Icon=utilities-terminal
Terminal=true
StartupNotify=false
